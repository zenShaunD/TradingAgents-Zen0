# OBOLUS — Zero-cost paper-mode environment template
# Copy to .env and fill in your values.
# Classification: TRADE SECRET — ZPAK / Zen Peace AK
#
# Cost target: $0/day
# LLM:  Ollama local (qwen3 + qwen3:1.7b on RTX 4070)
# Data: yfinance (default, $0) or Alpha Vantage free tier (25 req/day)

# ── OBOLUS operating mode ──────────────────────────────────────────────────
# PAPER = zero capital at risk (shadow observation)
# Do NOT change until 14-day shadow period is complete and signed off
OBOLUS_MODE=PAPER

# ── Audit paths (optional — safe defaults apply) ──────────────────────────
# OBOLUS_AUDIT_DIR=~/.obolus/audit
# OBOLUS_MEMORY_LOG_PATH=~/.obolus/audit/a1-shadow/trading_memory.md

# ── LLM stack — Ollama local ($0) ─────────────────────────────────────────
TRADINGAGENTS_LLM_PROVIDER=ollama
TRADINGAGENTS_DEEP_THINK_LLM=qwen3
TRADINGAGENTS_QUICK_THINK_LLM=qwen3:1.7b
TRADINGAGENTS_LLM_BACKEND_URL=http://localhost:11434/v1

# ── Data vendors ──────────────────────────────────────────────────────────
# yfinance is the $0 default — no key required.
# Uncomment and set ALPHA_VANTAGE_API_KEY to use Alpha Vantage free tier
# (25 req/day, 500/month — sufficient for 5 tickers at depth=1).
# Get free key at: https://www.alphavantage.co/support/#api-key
# ALPHA_VANTAGE_API_KEY=your_free_key_here

# ── TA-Z0 graph settings ──────────────────────────────────────────────────
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1
TRADINGAGENTS_CHECKPOINT_ENABLED=true

# ── Benchmark ────────────────────────────────────────────────────────────
TRADINGAGENTS_BENCHMARK_TICKER=SPY
